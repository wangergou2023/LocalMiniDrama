ble_debug"},"link":null}],"outputs":[{"label":"IMAGE","localized_name":"图像","name":"IMAGE","type":"IMAGE","links":[76,77]}],"properties":{"cnr_id":"seedvr2_videoupscaler","ver":"912ab4a5da8bb3590c4659f8f19160a7bd88a656","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.5.1"},"Node name for S&R":"SeedVR2VideoUpscaler","aux_id":"numz/ComfyUI-SeedVR2_VideoUpscaler","widget_ue_connectable":{"color_correction":true,"batch_size":true,"seed":true,"uniform_batch_size":true,"enable_debug":true,"latent_noise_scale":true,"prepend_frames":true,"offload_device":true,"temporal_overlap":true,"input_noise_scale":true,"resolution":true,"max_resolution":true},"ttNbgOverride":{"bgcolor":"#535","groupcolor":"#a1309b","color":"#323"}},"widgets_values":[1227150607,"randomize",1080,2048,41,false,"lab",0,0,0,0,"cpu",false],"color":"#2a363b","bgcolor":"#3f5159"},{"id":2,"type":"Note","pos":[1946.3702392578125,3012.5835620865155],"size":[414.3453674316406,715.8207397460938],"flags":{},"order":5,"mode":0,"inputs":[],"outputs":[],"title":"配置 DiT（扩散变换器）模型说明","properties":{"ue_properties":{"version":"7.8","widget_ue_connectable":{},"input_ue_unconnectable":{}}},"widgets_values":["型号：选择您的 DiT 型号\n\n3B 型号：速度更快，显存需求更低\n- seedvr2_ema_3b_fp16.safetensorsFP16（最佳质量）\n- seedvr2_ema_3b_fp8_e4m3fn.safetensorsFP8 8位（高质量）\n- seedvr2_ema_3b-Q4_K_M.ggufGGUF 4 位量化（质量可接受）\n- seedvr2_ema_3b-Q8_0.ggufGGUF 8 位量化（高质量）\n\n7B 型号：画质更高，显存需求更高\n- seedvr2_ema_7b_fp16.safetensorsFP16（最佳质量）\n- seedvr2_ema_7b_fp8_e4m3fn_mixed_block35_fp16.safetensors：FP8，最后一个数据块使用FP16，以减少伪影（质量良好）\n- seedvr2_ema_7b-Q4_K_M.ggufGGUF 4 位量化（质量可接受）\n- seedvr2_ema_7b_sharp_*：锐化版本，增强细节\n\n设备：用于 DiT 推理的 GPU 设备（例如，cuda:0）\n\noffload_device：当 DiT 模型不处于活跃处理状态时，用于卸载 DiT 模型的设备\n- none：将模型保存在推理设备（速度最快、显存最大的设备）上\n- cpu：卸载到系统内存（减少显存）\n- cuda:X：将负载转移到另一块GPU（如果可用，则可获得良好的负载均衡）\n\ncache_model：在工作流运行之间，保持卸载设备上的 DiT 模型加载状态\n- 适用于批量处理，避免重复加载\n- 需要设置 offload_device\n\nblocks_to_swap：块交换内存优化\n- 0：已禁用（默认）\n- 1-32：需要替换为 3B 型号的变压器模块数量\n- 1-36：需要更换为 7B 型号的变压器模块数量\n- 数值越高，节省的显存越多，但处理速度越慢。\n- 需要设置 offload_device 并且使其与 device 不同。\n\nswap_io_components：卸载输入/输出嵌入和归一化层\n\n- 结合 blocks_to_swap 可进一步节省 VRAM\n- 需要设置 offload_device 并且使其与 device 不同。\n\nattention_mode：注意力计算后端\n- sdpa: PyTorch scaled_dot_product_attention（默认值，稳定，始终可用）\n- flash_attnFlash Attention 2（在支持的硬件上速度更快，需要 flash-attn 软件包）\n\ntorch_compile_args：连接到 SeedVR2 Torch 编译设置节点，可提升 20-40% 的速度。\n\nBlockSwap详解：\nBlockSwap 允许在显存有限的 GPU 上运行大型模型，它在推理过程中动态地在 GPU 和 CPU 内存之间交换 Transformer 模块。其工作原理如下：\n\n- 它的作用：仅将当前需要的转换器模块保留在 GPU 上，而将其余模块存储在 CPU 或其他设备上。\n- 何时使用：在放大阶段出现 OOM（内存不足）错误时\n- 如何配置：\n设置offload_device为cpu或其他 GPU\n先从blocks_to_swap=16（一半的积木）开始\n如果仍然出现内存不足的情况，请增加到 24 或 32 (3B) / 36 (7B)。\n启用此功能swap_io_components可最大程度节省显存\n如果显存充足，可以降低或设置为 0 以加快处理速度。"],"color":"#323","bgcolor":"#535"},{"id":76,"type":"SetNode","pos":[1951.514668257746,2850.1375444951877],"size":[210,60],"flags":{},"order":32,"mode":0,"inputs":[{"label":"IMAGE","name":"IMAGE","type":"IMAGE","link":77}],"outputs":[{"label":"*","name":"IMAGE","type":"IMAGE"}],"title":"Set_video","properties":{"Node name for S&R":"SetNode","aux_id":"kijai/ComfyUI-KJNodes","previousName":"video","ue_properties":{"version":"7.8","widget_ue_connectable":{},"input_ue_unconnectable":{}}},"widgets_values":["video"],"color":"#2a363b","bgcolor":"#3f5159"},{"id":3,"type":"Note","pos":[1500.6686077894635,3273.510372623951],"size":[367.1238098144531,416.9341735839844],"flags":{},"order":8,"mode":0,"inputs":[],"outputs":[],"title":"SeedVR2 （主节点）部分关键参数说明","properties":{"ue_properties":{"version":"7.8","widget_ue_connectable":{},"input_ue_unconnectable":{}}},"widgets_values":["模型网址：https://github.com/numz/ComfyUI-SeedVR2_VideoUpscaler\n\n所需输入：\n\n图像：以图像批次形式输入视频帧（RGB 或 RGBA 格式）\ndit：来自 SeedVR2（下载）加载 DiT 模型节点的 DiT 模型配置\nvae：来自 SeedVR2（下载）加载 VAE 模型节点的 VAE 模型配置\n\n参数：\n\n- 种子：用于可重复生成的随机种子（默认值：42）\n使用相同种子和相同输入产生相同的输出\n\n- 分辨率：最短边的目标分辨率（以像素为单位）（默认值：1080）\n自动保持宽高比\n\n- max_resolution：任意边缘的最大分辨率（默认值：0 = 无限制）\n如果超出限制，则自动缩减规模以防止内存溢出 (OOM)。\n\nbatch_size：每批次帧数（默认值：5）\n\n- 关键要求：必须遵循4n+1 公式（1, 5, 9, 13, 17, 21, 25, ...）\n- 重要性：该模型使用这些帧进行时间一致性计算。\n- 为保证时间一致性，最低要求为 5：仅当需要单张图像或不需要时间一致性时才使用 1。\n- 尽量匹配镜头长度：为了获得最佳效果，请将 batch_size 设置为与您的镜头长度相匹配（例如，对于 20 帧的镜头，batch_size=21）。\n- 显存影响：更高的批处理大小意味着更好的质量和速度，但需要更多的显存。\n- 如果 batch_size=5 时出现内存溢出 (OOM) 问题：请先尝试优化技术（模型卸载、BlockSwap、GGUF 模型等），然后再考虑降低 batch_size 或输入分辨率，因为这些因素会直接影响质量。\n\n"],"color":"#323","bgcolor":"#535"}],"links":[[7,16,2,11,0,"*"],[8,16,3,12,0,"VHS_VIDEOINFO"],[9,12,2,13,0,"*"],[10,12,1,14,0,"*"],[11,12,0,15,0,"*"],[13,28,0,19,0,"*"],[14,31,0,20,0,"IMAGE"],[15,34,0,20,4,"INT"],[18,20,0,23,0,"IMAGE"],[19,25,0,24,0,"*"],[20,27,0,26,0,"*"],[25,23,3,33,0,"*"],[45,55,0,52,0,"*"],[51,68,0,69,0,"IMAGE"],[52,16,0,68,0,"IMAGE"],[56,16,2,72,1,"AUDIO"],[57,12,0,72,4,"FLOAT"],[60,29,0,77,1,"AUDIO"],[62,20,0,77,0,"IMAGE"],[63,21,0,78,0,"FLOAT"],[64,34,0,78,1,"INT"],[65,78,0,32,0,"FLOAT"],[66,78,0,77,4,"FLOAT"],[74,84,0,83,1,"SEEDVR2_DIT"],[75,85,0,83,2,"SEEDVR2_VAE"],[76,83,0,72,0,"IMAGE"],[77,83,0,76,0,"IMAGE"],[78,68,0,83,0,"IMAGE"]],"groups":[{"id":1,"title":"模型区：视频超分默认配置3B 型号的最佳质量（如希望进一步提升质量，可手动选择7B模型）","bounding":[1100.9798583984375,2744.611328125,1332.61669921875,1206.9375],"color":"#a1309b","flags":{}},{"id":2,"title":"上传视频（一键原帧率原时长高清放大）","bounding":[-133.50982666015625,2748.754638671875,1178.627685546875,1203.5640869140625],"color":"#8A8","flags":{}},{"id":3,"title":"如需补帧打开此组即可。默认设置：帧数*倍数、帧率*倍数（原时长不变）","bounding":[-141.16506958007812,1385.6446533203125,2578.281494140625,1289.760009765625],"color":"#8A8","flags":{}}],"config":{},"extra":{"links_added_by_ue":[],"ue_links":[],"0246.VERSION":[0,0,4],"ds":{"scale":0.5989500000000016,"offset":[914.1677442326063,-1616.027477220758]},"frontendVersion":"1.23.0","VHS_latentpreview":false,"VHS_latentpreviewrate":0,"VHS_MetadataImage":true,"VHS_KeepIntermediate":true},"version":0.4}